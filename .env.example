# Safe defaults only. No credentials are required.
# Process environment variables override this file for local launches.
HOST=127.0.0.1
PORT=3000
BODY_LIMIT_BYTES=16384

# Optional server-only generation settings; leave empty for the connectivity app.
# The separate openai:check CLI reads explicitly exported variables, not this file.
OPENAI_API_KEY=
OPENAI_MODEL=
